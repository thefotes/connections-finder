# Copy to .env (gitignored) and fill in. Real environment variables take precedence.

# Any OpenAI-compatible chat-completions endpoint that supports strict json_schema
# output: OpenAI, or a local server such as Ollama, LM Studio, vLLM or LiteLLM.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Set to 1 for vLLM/LiteLLM-served reasoning models to turn thinking off
# (sends chat_template_kwargs; OpenAI itself rejects that field).
LLM_DISABLE_THINKING=0
