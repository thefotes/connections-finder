# Copy to .env (gitignored) and fill in. Real environment variables take precedence.

# Any OpenAI-compatible chat-completions endpoint. IMPORTANT: the model must support
# strict JSON-schema structured outputs — run_all.py checks this up front.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- OpenRouter alternative (one key, many models, pay as you go) ---------------
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# LLM_MODEL=openai/gpt-4.1-mini

# --- Local alternative (Ollama) -------------------------------------------------
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=<a model that supports structured outputs>

# Set to 1 for vLLM/LiteLLM-served reasoning models to turn thinking off
# (sends chat_template_kwargs; OpenAI itself rejects that field).
LLM_DISABLE_THINKING=0
